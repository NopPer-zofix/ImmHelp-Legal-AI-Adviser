# Used by docker-compose.yml. Copy to .env and fill in the values; .env is never committed.

# OpenAI key used for answers, topic routing and document embeddings
OPENAI_API_KEY=

# Signs login tokens. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Password for the PostgreSQL container's `postgres` user (choose any strong value)
POSTGRES_PASSWORD=
