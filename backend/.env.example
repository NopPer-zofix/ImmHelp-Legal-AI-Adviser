OPENAI_API_KEY=sk-...
DATABASE_URL=postgresql://postgres:REDACTED_PASSWORD@localhost:5433/immhelp

# Signs login tokens. Generate once with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# 1 = auto-reload and the Werkzeug debugger. Never on a server others can reach.
FLASK_DEBUG=1

# Base for document download links handed to the model. Must match the frontend
# VITE_API_URL: /api in development, so the Vite proxy forwards them to Flask.
# If the API is served from another origin, use that full URL instead.
PUBLIC_BASE_URL=/api
